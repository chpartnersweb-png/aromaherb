---
import Icon from '../components/Icon.astro';
import Flower from '../components/Flower.astro';
import Seo from '../components/Seo.astro';
import { site, courses, rooms, roomPhotos, navigation } from '../data/site';
import { therapists } from '../data/therapists';
import '../styles/global.css';

---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#FFF1F4" />
    <meta name="generator" content={Astro.generator} />
    <Seo />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preload" as="image" href="/assets/images/hero-a-mobile.webp" media="(max-width: 600px)" />
    <link rel="preload" as="image" href="/assets/images/hero-a-tablet.webp" media="(min-width: 601px) and (max-width: 1100px)" />
    <link rel="preload" as="image" href="/assets/images/hero-a-desktop.webp" media="(min-width: 1101px)" />
  </head>
  <body>
    <a class="skip-link" href="#main">本文へ移動</a>

    <header class="site-header" id="site-header">
      <a class="brand" href="#home" aria-label={`${site.name} トップへ`}>
        <img src="/assets/brand/logo.svg" alt={site.name} width="520" height="142" />
      </a>
      <nav class="desktop-nav" aria-label="メインメニュー">
        {navigation.map(item => <a href={item.href}>{item.label}</a>)}
      </nav>
      <a class="header-phone" href={site.telephone}>
        <Icon name="phone" size={18} />
        <span><small>ご予約・お問い合わせ</small><strong>{site.phone}</strong></span>
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="メニューを開く">
        <span></span><span></span><small>MENU</small>
      </button>
      <nav class="mobile-menu" id="mobile-menu" aria-label="スマートフォン用メニュー" hidden>
        <p class="eyebrow">MENU</p>
        {navigation.map((item, index) => <a href={item.href}><span><small>0{index + 1}</small>{item.label}</span><Icon name="arrow" /></a>)}
        <a href={site.blog} target="_blank" rel="noopener noreferrer"><span>アメブロ</span><Icon name="diagonal" /></a>
        <a class="mobile-menu-phone" href={site.telephone}><span><Icon name="phone" />{site.phone}</span></a>
      </nav>
    </header>

    <main id="main">
      <section class="hero" id="home" aria-labelledby="hero-title">
        <picture class="hero-picture">
          <source media="(max-width: 600px)" srcset="/assets/images/hero-a-mobile.webp" />
          <source media="(max-width: 1100px)" srcset="/assets/images/hero-a-tablet.webp" />
          <img src="/assets/images/hero-a-desktop.webp" alt="ベージュの室内で腰掛け、ピンクのハートで顔を隠した女性の自撮り風イメージ。実際のセラピストや店舗の写真ではありません。" width="1672" height="941" fetchpriority="high" decoding="async" />
        </picture>
        <div class="hero-shade" aria-hidden="true"></div>
        <div class="hero-content">
          <p class="hero-location">熊本・水前寺／本荘のメンズエステ</p>
          <span class="hero-rule" aria-hidden="true"></span>
          <h1 id="hero-title">心ほどける、<br />やさしいひととき。</h1>
          <p class="hero-description">日常を少し離れて、<br class="mobile-break" />あなただけの癒しの時間を。</p>
          <p class="hero-price"><span>OIL MASSAGE</span><span><b>90</b>分 <strong>10,000</strong>円〜</span></p>
          <a class="button button-primary hero-button" href="#therapists">セラピストを見る<Icon name="arrow" size={18} /></a>
          <a class="hero-contact" href={site.telephone}><Icon name="phone" size={15} />ご予約・お問い合わせ</a>
        </div>
        <a class="scroll-cue" href="#therapists"><span>SCROLL</span><i></i></a>
        <span class="hero-image-note">イメージ画像</span>
      </section>

      <section class="entry-section" id="schedule" aria-labelledby="schedule-title">
        <div class="container entry-layout">
          <div class="schedule-notice">
            <span class="notice-icon"><Icon name="calendar" size={25} /></span>
            <div><p class="eyebrow">SCHEDULE & NEWS</p><h2 id="schedule-title">最新の出勤情報・お知らせ</h2><p>セラピストの出勤はアメブロでご案内しています。</p></div>
            <a class="notice-link" href={site.blog} target="_blank" rel="noopener noreferrer" aria-label="アメブロで最新の出勤情報を見る"><span>アメブロを見る</span><Icon name="diagonal" size={19} /></a>
          </div>
          <nav class="quick-links" aria-label="ご利用案内へのショートカット">
            <a href="#therapists"><Icon name="user" size={21} /><span>セラピスト</span><Icon name="arrow" size={15} /></a>
            <a href="#menu"><Icon name="clock" size={21} /><span>料金・コース</span><Icon name="arrow" size={15} /></a>
            <a href="#access"><Icon name="pin" size={21} /><span>お部屋の場所</span><Icon name="arrow" size={15} /></a>
          </nav>
        </div>
      </section>

      <section class="section therapists-section" id="therapists" aria-labelledby="therapists-title">
        <div class="container directory-layout">
          <div class="directory-main">
          <div class="directory-heading">
            <div><p class="eyebrow">THERAPISTS</p><h2 id="therapists-title">在籍セラピスト</h2></div>
            <span class="directory-caption">写真をタップしてプロフィールへ</span>
          </div>
          <div class="therapist-grid">
            {therapists.map(therapist => (
              <article class="therapist-card">
                <button type="button" class="profile-trigger" style={`--portrait-position: ${therapist.position}`} data-profile={`profile-${therapist.id}`} aria-haspopup="dialog" aria-controls={`profile-${therapist.id}`} aria-label={`${therapist.name}のプロフィールを見る`}>
                  <span class="portrait-wrap">
                    <img src={therapist.image.replace('.webp', '-card.webp')} srcset={`${therapist.image.replace('.webp', '-card.webp')} 600w, ${therapist.image} ${Math.min(therapist.imageWidth, 1200)}w`} sizes="(max-width: 600px) 46vw, (max-width: 1000px) 30vw, 23vw" alt={`${therapist.name}の紹介用イメージ画像。本人の容姿を示すものではありません。`} width={therapist.imageWidth} height={therapist.imageHeight} loading="lazy" decoding="async" />
                    <span class="image-note">イメージ画像</span>
                    <span class="portrait-view">VIEW PROFILE <Icon name="diagonal" size={16} /></span>
                  </span>
                  <span class="therapist-caption">
                    <span class="therapist-name"><span class="roman-name">{therapist.roman}</span><span class="japanese-name">{therapist.name}</span></span>
                    <span class="therapist-meta">{therapist.height && <span>{therapist.height}</span>}<span class="round-arrow"><Icon name="arrow" size={18} /></span></span>
                  </span>
                </button>
                <p class="therapist-brief">{therapist.facts[0] ? `${therapist.facts[0].label}：${therapist.facts[0].value}` : 'プロフィールをご覧ください'}</p>
              </article>
            ))}
          </div>
          <p class="image-disclaimer"><Icon name="heart" size={14} /><span>掲載画像はイメージです。実際のセラピストの容姿を示すものではありません。</span></p>
          <noscript><p class="no-script-note">詳しいプロフィールは<a href={site.therapistSource} target="_blank" rel="noopener noreferrer">アメブロのセラピスト紹介</a>をご覧ください。</p></noscript>
          </div>
          <aside class="visit-guide" aria-label="ご利用ガイド">
            <div class="guide-top"><Flower class="guide-flower" /><p class="eyebrow">INFORMATION</p><h3>ご利用ガイド</h3></div>
            <dl class="guide-facts"><div><dt>営業時間</dt><dd>{site.hours}</dd></div><div><dt>定休日</dt><dd>{site.closed}</dd></div><div><dt>エリア</dt><dd>水前寺・本荘</dd></div></dl>
            <div class="guide-price"><span>オイルマッサージ</span><p><b>90</b>分 <strong>10,000</strong>円〜</p><a href="#menu">すべてのコースを見る<Icon name="arrow" size={15} /></a></div>
            <a class="guide-contact" href={site.telephone}><span><Icon name="phone" size={15} />ご予約・お問い合わせ</span><strong>{site.phone}</strong></a>
            <a class="guide-blog" href={site.blog} target="_blank" rel="noopener noreferrer"><Icon name="calendar" size={18} />出勤情報を確認<Icon name="diagonal" size={16} /></a>
          </aside>
        </div>
      </section>

      <section class="section menu-section" id="menu" aria-labelledby="menu-title">
        <div class="container">
          <div class="section-heading"><div><p class="eyebrow">MENU & PRICE</p><h2 id="menu-title">コース・料金</h2></div><p class="section-lead">オイルマッサージ<br />お好きなコースをお選びください。</p><Flower class="heading-flower" /></div>
          <dl class="course-comparison">
            {courses.map(course => <div><dt><span>OIL MASSAGE</span><p><strong>{course.minutes}</strong><span>分</span></p></dt><dd><strong>{course.price}</strong><span>円</span></dd></div>)}
          </dl>
          <div class="price-footer"><p><span>延長料金</span>30分ごと <strong>3,000</strong>円</p><a class="text-link" href={site.telephone}>コースについて問い合わせる<Icon name="phone" size={16} /></a></div>
        </div>
      </section>

      <section class="section access-section" id="access" aria-labelledby="access-title">
        <div class="container">
          <div class="section-heading"><div><p class="eyebrow">ROOM & ACCESS</p><h2 id="access-title">お部屋・アクセス</h2></div><p class="section-lead">熊本・水前寺と本荘。<br />詳しいご案内はお電話でお問い合わせください。</p><Flower class="heading-flower" /></div>
          <div class="room-gallery" aria-label="お部屋の写真">
            {roomPhotos.map((photo, index) => (
              <figure class="room-photo">
                <img src={photo.src} alt={photo.alt} width={photo.width} height={photo.height} sizes={index === 0 ? '(max-width: 600px) 92vw, 46vw' : '(max-width: 600px) 44vw, 25vw'} loading="lazy" decoding="async" />
              </figure>
            ))}
          </div>
          <div class="rooms">
            {rooms.map(room => <article class="room"><span class="room-number" aria-hidden="true">{room.number}</span><div class="room-title"><span>ROOM {room.number}</span><h3>{room.name}<small>{room.english}</small></h3></div><p class="room-address"><Icon name="pin" size={19} /><span>{room.address}</span></p><p class="room-access">{room.access}</p></article>)}
          </div>
          <div class="contact-panel" id="contact">
            <div><p class="eyebrow">CONTACT</p><h3>ご予約・お問い合わせ</h3><p>空き状況やコースについて、お電話でご案内します。</p></div>
            <div class="contact-phone-wrap"><a class="contact-phone" href={site.telephone}><Icon name="phone" size={26} />{site.phone}</a><p><span>営業時間 {site.hours}</span><span>定休日 {site.closed}</span></p></div>
          </div>
        </div>
      </section>

      <section class="social-section" aria-labelledby="social-title">
        <div class="container social-layout"><div><p class="eyebrow">FOLLOW US</p><h2 id="social-title">お店からのお知らせ</h2><p>出勤情報や日々の発信はこちらから。</p></div><div class="social-links">
          <a href={site.instagram} target="_blank" rel="noopener noreferrer"><span class="social-name"><Icon name="instagram" size={27} /><span>Instagram<small>インスタグラム</small></span></span><Icon name="diagonal" /></a>
          <a href={site.blog} target="_blank" rel="noopener noreferrer"><span class="social-name"><Icon name="book" size={27} /><span>Ameblo<small>出勤情報・お知らせ</small></span></span><Icon name="diagonal" /></a>
        </div></div>
      </section>

      <section class="recruit-section" id="recruit" aria-labelledby="recruit-title">
        <Flower class="recruit-flower flower-one" /><Flower class="recruit-flower flower-two" />
        <div class="container recruit-layout"><div class="recruit-intro"><p class="eyebrow">RECRUIT</p><p class="recruit-label">セラピスト募集</p><h2 id="recruit-title">あなたらしいペースで、<br />はじめてみませんか。</h2><p>はじめての方には、女性オーナーによる講習も。<br />働き方やお仕事の詳細は、お電話でお話ししましょう。</p></div>
          <div class="recruit-details"><ul><li><Icon name="check" />日払い可</li><li><Icon name="check" />好きな時間に出勤可</li><li><Icon name="check" />女性オーナーによる講習あり</li></ul><a class="button button-primary" href={site.telephone}>求人について電話する<Icon name="phone" size={18} /></a><a class="recruit-phone" href={site.telephone}>{site.phone}</a></div>
        </div>
      </section>
    </main>

    <footer class="site-footer"><div class="container footer-top"><a class="footer-brand" href="#home"><img src="/assets/brand/logo.svg" alt={site.name} width="520" height="142" loading="lazy" /></a><p>熊本・水前寺／本荘<br /><span>10:00〜LAST ／ 不定休</span></p><a class="back-top" href="#home" aria-label="ページの先頭へ"><Icon name="arrow" size={20} /></a></div><div class="container footer-bottom"><nav aria-label="フッターメニュー">{navigation.map(item => <a href={item.href}>{item.label}</a>)}</nav><small>© {new Date().getFullYear()} aromaherb</small></div></footer>

    <nav class="mobile-dock" aria-label="クイックメニュー"><a href="#therapists"><Icon name="user" size={19} /><span>セラピストを見る</span></a><a href={site.telephone}><Icon name="phone" size={19} /><span>電話でお問い合わせ</span></a></nav>

    {therapists.map(therapist => (
      <dialog class:list={['profile-dialog', { 'profile-landscape': therapist.imageWidth > therapist.imageHeight }]} id={`profile-${therapist.id}`} aria-labelledby={`name-${therapist.id}`}>
        <div class="dialog-panel"><form method="dialog" class="dialog-close-form"><button class="dialog-close" aria-label="プロフィールを閉じる" autofocus><Icon name="close" size={23} /></button></form>
          <div class="dialog-portrait"><img src={therapist.image} alt={`${therapist.name}の紹介用イメージ画像。実際の本人写真ではありません。`} width={therapist.imageWidth} height={therapist.imageHeight} loading="lazy" decoding="async" /><span class="image-note">イメージ画像</span></div>
          <div class="dialog-content"><p class="eyebrow">THERAPIST PROFILE</p><p class="dialog-roman">{therapist.roman}</p><h2 id={`name-${therapist.id}`}>{therapist.name}</h2><dl class="profile-facts">{therapist.height && <div><dt>身長</dt><dd>{therapist.height}</dd></div>}{therapist.facts.map(fact => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}</dl><p class="profile-message">{therapist.description}</p><p class="profile-note">掲載画像はイメージです。実際のセラピストの容姿を示すものではありません。</p><a class="button button-primary" href={site.telephone}>出勤・空き状況を問い合わせる<Icon name="phone" size={17} /></a><a class="text-link" href={site.therapistSource} target="_blank" rel="noopener noreferrer">アメブロの紹介を見る<Icon name="diagonal" size={15} /></a></div>
        </div>
      </dialog>
    ))}
    <script src="../scripts/main.ts"></script>
  </body>
</html>
